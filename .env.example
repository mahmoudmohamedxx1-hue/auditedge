# --- Database -------------------------------------------------------------
# SQLite file, created automatically by `bun run db:push`.
DATABASE_URL=file:./db/custom.db

# --- AI engine (Z.ai open platform) ---------------------------------------
# Powers the AI Tutor, Industry Risk Analyst, KAM drafter, TB/JE analyzer
# and vision features. Create a key in your Z.ai account dashboard -
# GLM-4.7-Flash (reasoning) and GLM-4.6V-Flash (vision) have free tiers,
# GLM-4-Plus is pay-as-you-go. Without a key the learning platform, library
# and engagement tools work fully; AI features require it.
ZAI_OPEN_API_KEY=

# Optional override - defaults to https://api.z.ai/api/paas/v4
ZAI_OPEN_BASE_URL=
