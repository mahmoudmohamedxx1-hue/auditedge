generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  role           String   @default("learner") // learner | admin
  jobTitle       String   @default("")
  initials       String   @default("")
  passwordHash   String?  // scrypt hash — null until a password is set
  xp             Int      @default(0)
  streakDays     Int      @default(0)
  lastActiveAt   DateTime @default(now())
  isDemo         Boolean  @default(false) // seeded leaderboard colleagues
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /** Last lesson opened — powers the continue-where-you-left-off card (v20). */
  lastLessonId     String?
  lastLessonAt     DateTime?

  enrollments      Enrollment[]
  lessonProgress   LessonProgress[]
  quizAttempts     QuizAttempt[]
  certificates     Certificate[]
  materials        Material[]
  sessions         Session[]
  aiConversations  AiConversation[]
  bankAttempts     BankAttempt[]
  reviewItems      ReviewItem[]
  simRuns          SimRun[]
  lessonNotes      LessonNote[]
  studyPlans       StudyPlan[]
  examSessions     ExamSession[]

  @@index([xp])
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AiConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New conversation")
  /** v21: pinned conversations float to the top of the tutor rail. */
  pinned    Boolean  @default(false)
  /** v21: rolling summary of the messages that fell out of the 16-message
   *  context window — keeps long tutoring arcs coherent. */
  summary   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AiMessage[]
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant
  content        String
  sources        String   @default("[]") // JSON array of {url,name,snippet,host_name}
  /** Small thumbnail data-URL of an image the user attached (vision questions) */
  imageUrl       String?
  createdAt      DateTime @default(now())

  @@index([conversationId])
}

model Material {
  id           String   @id @default(cuid())
  title        String
  description  String   @default("")
  category     String   @default("Reference") // Reference | Standards | Egyptian Standards | IFRS | Templates | Working Papers | Policies
  fileName     String   @unique // stored file name on disk
  originalName String
  mimeType     String
  sizeBytes    Int
  textContent  String   @default("") // extracted text (RAG index for the AI tutor)
  sourceUrl    String   @default("") // official source link (ingested standards)
  hasFile      Boolean  @default(true) // false = DB-only record pointing at an external source
  uploadedById String?
  uploader     User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
}

model Course {
  id             String  @id @default(cuid())
  slug           String  @unique
  code           String // e.g. ISA-315
  title          String
  subtitle       String
  description    String
  category       String // "International Standards" | "Egyptian Framework" | "IFRS" | "Analytics"
  level          String // "Foundation" | "Intermediate" | "Advanced"
  cpeHours       Float
  instructorName String
  instructorTitle String
  instructorBio  String
  rating         Float   @default(0)
  ratingCount    Int     @default(0)
  studentsCount  Int     @default(0)
  icon           String // lucide icon key
  accent         String // "terracotta" | "olive" | "sage" | "plum" | "sand" | "clay"
  featured       Boolean @default(false)
  published      Boolean @default(true)
  order          Int     @default(0)
  sourcePlatform String  @default("") // youtube | coursera | edx | mit-ocw | openstax | "" (built in-house)
  sourceUrl      String  @default("") // original URL when imported from a free external source
  /** true = curated external video import used as a supplement to the
   *  in-house curriculum — shown with a badge and ordered after core courses (P1-6). */
  supplementary  Boolean @default(false)

  modules       Module[]
  enrollments   Enrollment[]
  certificates  Certificate[]
}

model Module {
  id          String  @id @default(cuid())
  courseId    String
  course      Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  description String  @default("")
  order       Int

  lessons Lesson[]
}

model Lesson {
  id         String  @id @default(cuid())
  moduleId   String
  module     Module  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title      String
  type       String  @default("lesson") // lesson | quiz
  durationMin Int    @default(12)
  xp         Int     @default(10)
  content     String  @default("{}") // JSON blob: sections, keyPoints, example, takeaway
  /** Arabic rendition of the same content JSON (empty = no AR version yet) (v20 / P1-6). */
  contentAr   String  @default("")
  attachments String  @default("[]") // JSON array of material ids
  videoUrl    String  @default("") // optional YouTube video for this lesson
  externalUrl String  @default("") // optional external link (MOOC platform lesson)
  order       Int

  quiz         Quiz?
  progress     LessonProgress[]
  notes        LessonNote[]
}

model Quiz {
  id         String  @id @default(cuid())
  lessonId   String  @unique
  lesson     Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  courseId   String
  title      String
  passScore  Int     @default(70) // percent
  questions  String  // JSON array

  attempts QuizAttempt[]
}

model Enrollment {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@unique([userId, courseId])
}

model LessonProgress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completedAt DateTime @default(now())

  @@unique([userId, lessonId])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId    String
  quiz      Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  score     Int // percent
  correct   Int
  total     Int
  passed    Boolean
  createdAt DateTime @default(now())
}

model Certificate {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  serial    String   @unique
  issuedAt  DateTime @default(now())

  @@unique([userId, courseId])
}

/* ================================================================== */
/* v20 — Exam-readiness core (P0-1 / P0-3)                            */
/* ================================================================== */

/** One item in the seeded question bank (P0-1). Options/answer live in
 *  JSON columns so the bank stays portable across SQLite and Postgres. */
model BankQuestion {
  id            String   @id @default(cuid())
  code          String   @unique // stable slug, e.g. "ISA315-RISK-01"
  stem          String
  stemAr        String? // Arabic rendition (P1-6) — null = EN only
  options       String // JSON array of option strings (EN)
  optionsAr     String? // JSON array (AR)
  answerIndex   Int // 0..3
  explanation   String
  explanationAr String?
  standardTag   String // e.g. "ISA 315" | "EAS 1" | "IFRS 15" | "Ethics"
  area          String // exam section: auditing | accounting | ethics | egypt
  difficulty    Int      @default(2) // 1 easy · 2 medium · 3 hard
  source        String   @default("AuditEdge bank")
  courseId      String? // set when the item mirrors a course quiz
  createdAt     DateTime @default(now())

  attempts BankAttempt[]

  @@index([area])
  @@index([standardTag])
}

/** A single graded answer against a bank question (server-graded). */
model BankAttempt {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   BankQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  picked     Int
  correct    Boolean
  mode       String // practice | exam | review
  examId     String? // ExamSession id when answered inside an exam
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([questionId])
}

/** A timed mock-exam sitting (60/90 min) or a practice set (P0-1). */
model ExamSession {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mode          String // exam60 | exam90 | practice
  blueprint     String    @default("[]") // JSON: [{area, tag?, count, picked}]
  questionIds   String // JSON array of bank question ids in sitting order
  answered      String    @default("{}") // JSON {questionId: picked}
  flagged       String    @default("[]") // JSON [questionId]
  durationMin   Int
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  score         Int? // percent (set on submit)
  correct       Int?
  total         Int
  timedOut      Boolean   @default(false) // v21: submitted after the clock expired (server-enforced)
  sectionScores String    @default("{}") // JSON {area: {correct, total}}

  @@index([userId, startedAt])
}

/** A spaced-repetition card (P0-3) — lesson key points and missed bank
 *  questions scheduled with an SM-2-lite algorithm. */
model ReviewItem {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String // keypoint | question
  refId       String // lessonId (keypoint) or BankQuestion id (question)
  refKey      String // "lesson:<lessonId>:<index>" or "bank:<questionId>"
  title       String
  front       String // prompt side of the flashcard
  back        String // answer side
  frontAr     String?
  backAr     String?
  ease        Float    @default(2.5)
  intervalDays Int    @default(0)
  dueAt       DateTime @default(now())
  reps        Int      @default(0)
  lapses      Int      @default(0)
  lastGrade   Int? // 0 again · 1 hard · 2 good · 3 easy
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, refKey])
  @@index([userId, dueAt])
}

/* ================================================================== */
/* v20 — Retention & differentiation (P1-5 / P1-4 / P2-9)             */
/* ================================================================== */

/** One run of the case-based engagement simulation (P1-5). */
model SimRun {
  id          String    @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario    String // scenario slug, e.g. "nile-textiles-fy26"
  status      String    @default("active") // active | completed
  stage       Int       @default(0)
  decisions   String    @default("[]") // JSON [{stageId, decisionId, picked, judged, score, feedback}]
  score       Int       @default(0) // 0-100 when completed
  startedAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?

  @@index([userId, startedAt])
}

/** A learner note or text highlight attached to a lesson (P2-9). */
model LessonNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId  String
  lesson    Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  kind      String // note | highlight
  text      String
  quote     String   @default("") // highlighted source text (highlights)
  color     String   @default("amber")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, lessonId])
}

/** A persisted, trackable AI study plan (P1-4). */
model StudyPlan {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  goal        String   @default("")
  horizonWeeks Int     @default(4)
  plan        String // JSON: { weeks: [{ focus, items: [{ label, ref?, done }] }] }
  progress    Int      @default(0) // percent of items done
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}
